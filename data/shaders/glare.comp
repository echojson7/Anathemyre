#version 460
#extension GL_GOOGLE_include_directive : require
// Пирамида блеска (docs/glare.md). pc.a — что делать: 0 — уровень 0 «вниз» из кадра после сглаживания (история
// pc.b), 1 — уровень pc.b «вниз» из уровня ниже, 2 — уровень pc.b «вверх»: свой «вниз» плюс размытый «вверх»
// уровня крупнее. Вниз — фильтр 4×4 с весами (1 3 3 1)/8 по осям (без ступенек и мерцания при сдвиге), вверх —
// четыре билинейные выборки крупного уровня (шатёр). 3 — солнце в кадре (docs/lens.md): одна группа
#include "glare.glsl"
layout(set = 0, binding = 13, rgba16f) uniform readonly image2D u_aa[2];
layout(local_size_x = 8, local_size_y = 8) in;

shared float s_vis[64];

float gr_max3(vec3 v) { return max(v.x, max(v.y, v.z)); }

// Видимая доля диска солнца (корона, блики объектива): 64 точки подсолнухом по диску до 0.7 радиуса в кадре
// после сглаживания. Точка видна, если ярче 55 % того, что даёт открытый диск (с пределом atmo_sun_cap и
// потемнением к краю); облако на диске — доля, а не ноль. Точки за краем кадра — не видны: диск уходит за край
// плавно. В lens_sun[0]: доля, середина диска в пикселях, отступ середины от края кадра (0 — у края, 1 — дальше
// 8 % высоты кадра)
void sun_measure() {
    FrameData f = pc.frame;
    uint i = gl_LocalInvocationIndex;
    vec3 s = f.a_sun.xyz;
    float vf = dot(s, f.forward.xyz);
    bool up = vf > 0.05 && s.y > -0.02;
    vec2 sp = vec2(-1e4);
    float v = 0.0;
    if (up) {
        vec2 ndc = vec2(dot(s, f.right.xyz) * f.proj_x, -dot(s, f.up.xyz) * f.proj_y) / vf;
        sp = (ndc + 1.0) / f.ndc_per_pixel;
        float rs = f.a_sun_halo.w;
        float rp = rs / (f.pixel_angle * vf);
        float a = float(i) * 2.39996323, r = 0.7 * rp * sqrt((float(i) + 0.5) / 64.0);
        ivec2 q = ivec2(floor(sp + r * vec2(cos(a), sin(a))));
        ivec2 sz = ivec2(f.viewport);
        if (all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, sz))) {
            vec3 h = pc.b == 0u ? imageLoad(u_aa[0], q).rgb : imageLoad(u_aa[1], q).rgb;
            vec3 e0 = f.a_sun.w / (A_PI * rs * rs) * exp(-f.a_sun_halo.rgb);
            float ex = f.sky_out.v[SKY_OUT_EYE].x;
            float open = min(atmo_sun_cap(), gr_max3(e0 * f.a_sun_t.rgb) * 1.2 * ex);
            v = smoothstep(0.3, 0.55, gr_max3(h) / max(open, 1e-9));
        }
    }
    s_vis[i] = v;
    barrier();
    if (i != 0u) return;
    float sum = 0.0;
    for (uint k = 0u; k < 64u; ++k) sum += s_vis[k];
    float edge = min(min(sp.x, f.viewport.x - sp.x), min(sp.y, f.viewport.y - sp.y));
    f.lens_sun.v[0] = vec4(sum / 64.0, sp, clamp(edge / (0.08 * f.viewport.y), 0.0, 1.0));
}

const float W4[4] = float[4](0.125, 0.375, 0.375, 0.125);

void gr_put(int off, ivec2 sz, ivec2 p, vec3 c) {
    pc.frame.gr_buf.v[off + p.y * sz.x + p.x] = uvec2(packHalf2x16(c.rg), packHalf2x16(vec2(c.b, 0.0)));
}

vec3 src_px(ivec2 p, ivec2 sz) {
    p = clamp(p, ivec2(0), sz - 1);
    vec3 c = pc.b == 0u ? imageLoad(u_aa[0], p).rgb : imageLoad(u_aa[1], p).rgb;
    // Предел: единичный блик в f16 не должен залить полкадра
    float m = max(c.r, max(c.g, c.b));
    return max(c, vec3(0.0)) * min(1.0, 4000.0 / max(m, 1e-6));
}

void main() {
    FrameData f = pc.frame;
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    uint mode = pc.a;
    if (mode == 3u) {
        sun_measure();
        return;
    }
    int k = mode == 0u ? 0 : int(pc.b);
    ivec4 l = f.gr_lv[k];
    if (p.x >= l.x || p.y >= l.y) return;
    vec3 c = vec3(0.0);
    if (mode == 0u) {
        ivec2 sz = imageSize(u_aa[0]);
        for (int y = 0; y < 4; ++y)
            for (int x = 0; x < 4; ++x) c += src_px(p * 2 + ivec2(x - 1, y - 1), sz) * (W4[x] * W4[y]);
        gr_put(l.z, l.xy, p, c);
    } else if (mode == 1u) {
        ivec4 s = f.gr_lv[k - 1];
        for (int y = 0; y < 4; ++y)
            for (int x = 0; x < 4; ++x) c += gr_get(s.z, s.xy, p * 2 + ivec2(x - 1, y - 1)) * (W4[x] * W4[y]);
        gr_put(l.z, l.xy, p, c);
    } else {
        c = gr_get(l.z, l.xy, p);
        if (k + 1 < int(f.gr_n)) {
            ivec4 u = f.gr_lv[k + 1];
            vec2 q = (vec2(p) + 0.5) * 0.5;
            vec3 t = gr_lerp(u.w, u.xy, q + vec2(-0.5, -0.5)) + gr_lerp(u.w, u.xy, q + vec2(0.5, -0.5)) +
                     gr_lerp(u.w, u.xy, q + vec2(-0.5, 0.5)) + gr_lerp(u.w, u.xy, q + vec2(0.5, 0.5));
            c += t * (0.25 * GLARE_FALL);
        }
        gr_put(l.w, l.xy, p, c);
    }
}
