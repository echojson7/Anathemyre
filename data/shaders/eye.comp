#version 460
#extension GL_GOOGLE_include_directive : require
// Глаз (docs/light.md, «Экспозиция», «Баланс белого»). Экспонометр падающего света: к чему привыкает глаз.
// - Свет у камеры: небо и главный свет на горизонтальную плоскость (sky_sum.comp) с заслонкой полем расстояний
//   (docs/sdf.md, «Глаз»), рассеянный — из зондов (docs/gi.md), огни — купол у камеры с тенью по полю (docs/lamps.md).
// - Свет мест в кадре (с 17.11): свет места (`g_e_local`, освещённость, какую намерил бы экспонометр в этой точке)
//   прошлого кадра — средние плиток 8×8 (view_light, light_cells.comp) на сетке 64×36 по экрану, среднее логарифма
//   с весом к центру. Так меряют падающий свет фотографы — у предмета, а не у камеры: в зале Остова площадка вверх у
//   камеры видит тёмный потолок (180 лк), а стены и пол, на которые смотрят, освещены втрое сильнее (536 лк), и кадр
//   выходил белым. Это не гистограмма кадра: свет места — свойство точки мира, белая стена не темнит кадр, тёмный
//   камень не светлит. Плитка хранит свет места против света у камеры своего кадра: замер — это отношение × свет у
//   камеры сейчас, и после скачка часов (снимок, --timelapse) он не тянет свет прошлого часа.
// Замер — смесь двух в логарифме (eye_meter.x); EV100 = log2(E / 2.5) (C = 250); глаз сдвигает EV от «нормы» на
// долю adapt; множитель — как у камеры с насыщением ISO 100: 2^поправка / (1.2 · 2^EV). Привыкание плавное.
// Баланс белого: цвет света — та же смесь у камеры и мест в кадре (стоя в тени, глаз смотрит на освещённое
// солнцем; в зале у камеры луч из окна, а смотрит он на стены в свете неба) → множители конусов CAT02 (фон Крис)
// с долей привыкания CIECAM02 × eye_meter.z.
// Группа из 64 потоков: замер сеткой, сложение в общей памяти в постоянном порядке (кадр от запуска к запуску тот
// же), остальное — поток 0. После sky_sum, сборки поля и смешения зондов, до освещения
#include "gi.glsl"
#include "lamps.glsl"
#include "clouds.glsl"
layout(local_size_x = 64) in;

shared float s_lw[64], s_w[64];
shared vec3 s_c[64];

const vec3 Y = vec3(0.2126, 0.7152, 0.0722);

// Множители конусов CAT02 для света w (линейный sRGB): он виден белым D65 с долей d; белое той же яркости
vec3 wb_gains(vec3 w, float d) {
    const mat3 rgb_lms = mat3(0.390405360, 0.070841590, 0.023108180, 0.549941120, 0.963171760, 0.128020800,
                              0.008926320, 0.001357750, 0.936245120);
    const mat3 lms_rgb = mat3(2.858467668, -0.210182267, -0.041812003, -1.628787726, 1.158200856, -0.118169353,
                              -0.024891036, 0.000324281, 1.068666368);
    vec3 lw = max(rgb_lms * w, vec3(1e-6));
    vec3 lr = rgb_lms * vec3(dot(w, Y));
    // Предел втрое: под чисто цветным светом (красная лампа) глаз белого не находит — цвет остаётся цветом
    vec3 g = clamp(d * lr / lw + (1.0 - d), vec3(1.0 / 3.0), vec3(3.0));
    float y = dot(lms_rgb * (g * lw), Y);
    return g * (dot(w, Y) / max(y, 1e-6));
}

void main() {
    FrameData f = pc.frame;
    uint t = gl_LocalInvocationIndex;
    // Свет мест в кадре: столбец сетки на поток. Первый кадр и новый размер (плитки не записаны) — мимо
    float lw = 0.0, w = 0.0;
    vec3 cw = vec3(0.0);
    if (f.eye_meter.y != 0.0) {
        uint tx = (uint(f.viewport.x) + 7u) / 8u;
        for (uint j = 0u; j < 36u; ++j) {
            vec2 uv = (vec2(float(t), float(j)) + 0.5) / vec2(64.0, 36.0);
            uvec2 q = uvec2(uv * f.viewport) / 8u;
            vec4 v = f.view_light.v[min(q.y * tx + q.x, f.tile_cap - 1u)];
            if (!(abs(v.w) < 60.0)) continue;  // не число — мимо
            vec2 d = uv * 2.0 - 1.0;
            float wt = exp(-dot(d, d) * (1.0 / (2.0 * 0.45 * 0.45)));  // вес к центру кадра
            lw += wt * v.w;
            cw += wt * clamp(v.rgb, vec3(0.0), vec3(100.0));
            w += wt;
        }
    }
    s_lw[t] = lw;
    s_w[t] = w;
    s_c[t] = cw;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (t < s) {
            s_lw[t] += s_lw[t + s];
            s_w[t] += s_w[t + s];
            s_c[t] += s_c[t + s];
        }
        barrier();
    }
    if (t != 0u) return;

    // Плоскость вверх: E = π·(a + by) — как у sky_sum.comp
    vec3 c_sky = (f.sky_out.v[0].rgb + f.sky_out.v[2].rgb) * A_PI;
    float e_sky = max(dot(c_sky, Y), 0.0);
    // Светило — с тенью облаков над камерой: под облаком глаз привыкает к его тени
    vec3 c_key = f.sun_color.rgb * max(f.sun_dir.y, 0.0) * cloud_shadow(vec3(0.0));
    float e_key = max(dot(c_key, Y), 0.0);
    // Заслонка у камеры: небо — конусами «Ультра» (не зависит от ступени), светило — узкий конус к нему
    vec2 vis_sky = sdf_sky_q(vec3(0.0), vec3(0.0, 1.0, 0.0), LIGHT_Q_ULTRA);
    float vis_key = 1.0;
    if (f.sdf_on != 0u && f.sun_dir.y > 0.0) {
        float v0 = f.sdf_cam.w;
        vis_key = sdf_cone(f.sdf_cam.xyz + vec3(0.0, 0.5 * v0, 0.0), f.sun_dir.xyz, 0.12, v0, 40.0, 24u).x;
    }
    float e_open = max(e_sky + e_key, 1e-6);
    // Рассеянный — из зондов (вверх, у камеры), вне их окон — небо с видимостью по полю
    GiSample g = gi_sample(vec3(0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 1.0, 0.0), false);
    vec3 c_amb = mix(c_sky * (vis_sky.x * (1.0 - gi_buried(f.sdf_cam.xyz))), g.irr * A_PI, g.cov);
    float e_amb = max(dot(c_amb, Y), 0.0);
    // Огни: купол экспонометра — среднее площадок вверх и к огню (лампа сбоку светит в купол вполовину)
    vec3 c_lamp = vec3(0.0);
    uint nl = min(f.light_count, 1024u);
    for (uint i = 0u; i < nl; ++i) {
        Light l = f.lights.v[i];
        vec3 q = lamp_closest(l, vec3(0.0));
        float d = length(q);
        if (d >= l.radius || d < 1e-3) continue;
        vec3 to = q / d;
        c_lamp += lamp_e(l, vec3(0.0), to, 24u) * (0.5 + 0.5 * max(to.y, 0.0));
    }
    float e_lamp = max(dot(c_lamp, Y), 0.0);
    float e_cam = max(e_amb + e_key * vis_key + e_lamp, 1e-6);
    // Замер: свет у камеры и свет мест в кадре — в логарифме
    bool view = s_w[0] > 1.0;
    float mv = view ? clamp(f.eye_meter.x, 0.0, 1.0) : 0.0;
    float e_view = view ? e_cam * exp2(s_lw[0] / s_w[0]) : e_cam;
    float e = exp2(mix(log2(e_cam), log2(e_view), mv));
    float ev_scene = log2(e / 2.5);
    float ev_ref = f.a_post.z;
    float ev_goal = ev_ref + f.a_post.y * (ev_scene - ev_ref);
    float ev = ev_goal;
    float ev_prev = f.sky_out.v[SKY_OUT_EYE].z;
    // Прошлое значение годно, если не первый кадр и оно в разумных пределах (буфер в начале — мусор)
    bool keep = f.eye_snap == 0u && ev_prev > -20.0 && ev_prev < 30.0;
    if (keep) {
        float tau = ev_goal < ev_prev ? f.a_misc.y : f.a_misc.z;
        ev = ev_prev + (ev_goal - ev_prev) * (1.0 - exp(-max(f.dt, 0.0) / max(tau, 1e-3)));
    }
    // Ночь темнее привыкания (docs/sky.md, «Ночь»): от ~20 лк у глаза кадр уходит в темноту на night_dark EV —
    // полностью к свету полной луны (0.35 лк). Темнее луны глаз привыкает слабо (adapt_night): безлунная ночь
    // темнее лунной, а не светлее. По свету, к которому глаз уже привык (из плавного EV), а не по часу: под
    // лампами и днём в зале поправки нет. В [4].z — EV без неё: по нему post.glsl снимает синеву под лампами
    const float L_MOON = -1.5;  // log2(0.35 лк)
    float le = f.a_post.y > 0.05 ? log2(2.5) + ev_ref + (ev - ev_ref) / f.a_post.y : log2(e);
    float ev_night = f.a_misc.w * (1.0 - smoothstep(L_MOON, 4.3, le)) + (f.a_post.y - f.a_night2.x) * max(L_MOON - le, 0.0);
    float ex = exp2(f.a_post.x) / (1.2 * exp2(ev + ev_night));

    // Баланс белого: цвет света у камеры, плавно (eye_meter.w, с). Доля привыкания — CIECAM02 по яркости фона
    // (серый 20 % под светом замера, кд/м²): ~0.82 в полутьме, к 1 на солнце; × eye_meter.z
    vec3 c_eye = max(c_amb + c_key * vis_key + c_lamp, vec3(0.0));
    vec3 wp = dot(c_eye, Y) > 1e-9 ? c_eye / dot(c_eye, Y) : vec3(1.0);
    vec3 wv = s_c[0] / max(s_w[0], 1e-6);
    if (view && dot(wv, Y) > 1e-3) wp = mix(wp, wv / dot(wv, Y), mv);
    vec3 wp_prev = f.sky_out.v[SKY_OUT_WB2].xyz;
    bool wp_ok = all(greaterThan(wp_prev, vec3(1e-4))) && all(lessThan(wp_prev, vec3(1e4)));
    if (keep && wp_ok) {
        wp = mix(wp_prev, wp, 1.0 - exp(-max(f.dt, 0.0) / max(f.eye_meter.w, 1e-3)));
        wp /= max(dot(wp, Y), 1e-6);
    }
    float la = exp2(le) / (5.0 * A_PI);
    float dg = clamp(1.0 - exp((-la - 42.0) / 92.0) / 3.6, 0.0, 1.0) * clamp(f.eye_meter.z, 0.0, 1.0);
    f.sky_out.v[SKY_OUT_WB] = vec4(dg > 0.0 ? wb_gains(wp, dg) : vec3(1.0), dg);
    f.sky_out.v[SKY_OUT_WB2] = vec4(wp, e_view);

    // [4].y — освещённость открытой земли: по ней ночная синева (post.glsl), заслонка её не трогает
    f.sky_out.v[SKY_OUT_EYE] = vec4(ex, e_open, ev, e_sky);
    // [8] — свет открытой земли цветом (свет мест неба и дали) и свет у камеры (к нему плитки пишут свет мест)
    f.sky_out.v[SKY_OUT_VIEW] = vec4(max(c_sky + c_key, vec3(0.0)), e_cam);
    // [5].z — замер (к нему привыкает глаз); [5].w — освещённость воздуха у глаза против открытого неба: дымке
    // ближних отрезков (light.glsl) — по свету у камеры, не по кадру
    f.sky_out.v[SKY_OUT_EYE2] = vec4(e_key, ev_goal, e, clamp(e_amb / max(e_sky, 1e-6), 0.0, 1.0));
}
