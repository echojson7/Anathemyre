#version 460
#extension GL_GOOGLE_include_directive : require
// Отсечение, шаг 1: на экземпляр (группа, cull.glsl) — сколько его кластеров видно и какой LOD
#include "cull.glsl"
layout(local_size_x = 64) in;  // CULL_GROUP: группа на экземпляр

void main() {
    FrameData f = pc.frame;
    uint i = cull_group_instance();
    if (i >= f.instance_count) return;
    uint lod;
    uint n = cull_instance(i, false, 0u, lod);
    if (gl_LocalInvocationIndex == 0u) f.cull.count[i] = n | (lod << 29);
}
