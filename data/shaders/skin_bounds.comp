#version 460
#extension GL_GOOGLE_include_directive : require
// Сферы кластеров человека после скиннинга (docs/people.md, «Скиннинг»): группа на кластер, y — человек кадра.
// Коробка вершин кластера → середина и наибольшее расстояние до неё (как bound_sphere в vk_geometry.cpp);
// по ним отсекает cull.glsl. Пересчитываются кластеры LOD, вершины которого скинены, и грубее
#include "common.glsl"
layout(local_size_x = 64) in;

shared vec3 s_lo[64], s_hi[64];
shared float s_r[64];

// Индексов кластера ≤ 124 × 3 = 372 (MESH_MAX_CLUSTER_TRIS, src/asset/mesh.h): поток берёт до 6 через 64. Чтение
// буфера и свёртка — без циклов: lavapipe под GPU-AV падал на доступе к буферу в цикле шейдера с barrier()
// (docs/graph.md, «Циклы с буфером»); положения читаются раз и держатся в локальных для второго прохода
#define SB_READ(r)                                                              \
    {                                                                           \
        uint k = t + (r) * 64u;                                                 \
        if (k < n) {                                                            \
            Vertex v = f.vertices.v[j.dst_vertex + f.indices.v[first + k]];     \
            pos[r] = vec3(v.px, v.py, v.pz);                                    \
            lo = min(lo, pos[r]);                                               \
            hi = max(hi, pos[r]);                                               \
        }                                                                       \
    }
#define SB_FAR(r) \
    if (t + (r) * 64u < n) r2 = max(r2, dot(pos[r] - mid, pos[r] - mid));
#define SB_BOX(s)                                          \
    if (t < (s)) {                                         \
        s_lo[t] = min(s_lo[t], s_lo[t + (s)]);             \
        s_hi[t] = max(s_hi[t], s_hi[t + (s)]);             \
    }                                                      \
    barrier();
#define SB_RAD(s)                                          \
    if (t < (s)) s_r[t] = max(s_r[t], s_r[t + (s)]);       \
    barrier();

void main() {
    FrameData f = pc.frame;
    SkinJob j = f.skin_jobs.v[gl_WorkGroupID.y];
    if (gl_WorkGroupID.x >= j.cluster_count) return;  // вся группа разом
    uint t = gl_LocalInvocationIndex;
    uint ci = j.first_cluster + gl_WorkGroupID.x;
    Cluster c = f.clusters.v[ci];
    uint n = min(c.tri_count, 124u) * 3u, first = j.first_index + c.first_index;
    vec3 lo = vec3(1e30), hi = vec3(-1e30);
    vec3 pos[6] = vec3[6](vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0));
    SB_READ(0u) SB_READ(1u) SB_READ(2u) SB_READ(3u) SB_READ(4u) SB_READ(5u)
    s_lo[t] = lo;
    s_hi[t] = hi;
    barrier();
    SB_BOX(32u) SB_BOX(16u) SB_BOX(8u) SB_BOX(4u) SB_BOX(2u) SB_BOX(1u)
    vec3 mid = (s_lo[0] + s_hi[0]) * 0.5;
    float r2 = 0.0;
    SB_FAR(0u) SB_FAR(1u) SB_FAR(2u) SB_FAR(3u) SB_FAR(4u) SB_FAR(5u)
    s_r[t] = r2;
    barrier();
    SB_RAD(32u) SB_RAD(16u) SB_RAD(8u) SB_RAD(4u) SB_RAD(2u) SB_RAD(1u)
    if (t == 0u) f.clusters_w.v[ci].sphere = vec4(mid, sqrt(s_r[0]) * 1.0001 + 1e-4);
}
