#version 460
#extension GL_GOOGLE_include_directive : require
// Свет всего неба на плоскость (docs/sky.md): таблицы вида неба солнца и луны → сферические гармоники
// первого порядка, плюс отсвет земли снизу и ночное свечение. И экспозиция кадра по этой освещённости
// (docs/light.md, «Экспозиция»). sky_out: [0] — постоянная часть, [1..3] — по x, y, z (atmo_ambient),
// [4], [5] — глаз (SKY_OUT_EYE в common.glsl). Буфер один на все кадры: [4] прошлого кадра — начало привыкания
#include "atmosphere.glsl"
layout(local_size_x = 256) in;

shared vec3 s_acc[256][4];

// Тексель таблицы → вклад в гармоники. В таблице азимут 0..π, вторая половина неба — зеркальная: боковые
// составляющие направления сокращаются, остальное удваивается
void add_lut(Vec4s b, int W, int H, int k, vec3 light, float E, float alt, inout vec3 acc[4]) {
    int x = k % W, y = k / W;
    vec2 uv = (vec2(x, y) + 0.5) / vec2(W, H);
    vec3 d = sky_dir(uv, alt);
    float e0 = asin(sky_dir(vec2(uv.x, float(y) / float(H)), alt).y);
    float e1 = asin(sky_dir(vec2(uv.x, float(y + 1) / float(H)), alt).y);
    float dw = 2.0 * cos(asin(d.y)) * (A_PI / float(W)) * abs(e1 - e0);
    vec4 v = b.v[k];
    vec3 L = v.rgb * E * pc.frame.a_misc.x;
    if (d.y < atmo_horizon(alt) + 1e-4) {
        // Луч в землю: к рассеянному свету — земля в тени неба, освещённая светилами
        FrameData f = pc.frame;
        vec3 eg = f.a_sun.w * f.a_sun_t.rgb * max(f.a_sun.y, 0.0) + f.a_moon.w * f.a_moon_t.rgb * max(f.a_moon.y, 0.0);
        L += v.a * f.a_ground.rgb / A_PI * eg * 0.5;
    }
    vec2 lh = normalize(light.xz + vec2(1e-6, 0.0));
    vec3 wd = vec3(lh.x * d.x, d.y, lh.y * d.x);  // в осях мира, боковая часть (d.z) сокращается
    acc[0] += L * dw;
    acc[1] += L * dw * wd.x;
    acc[2] += L * dw * wd.y;
    acc[3] += L * dw * wd.z;
}

void main() {
    FrameData f = pc.frame;
    uint t = gl_LocalInvocationID.x;
    float alt = atmo_cam_alt();
    vec3 acc[4] = vec3[4](vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0));
    for (int k = int(t); k < SKY_W * SKY_H; k += 256) add_lut(f.sky_sun, SKY_W, SKY_H, k, f.a_sun.xyz, f.a_sun.w, alt, acc);
    for (int k = int(t); k < MOON_W * MOON_H; k += 256)
        add_lut(f.sky_moon, MOON_W, MOON_H, k, f.a_moon.xyz, f.a_moon.w, alt, acc);
    for (int i = 0; i < 4; ++i) s_acc[t][i] = acc[i];
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (t < s)
            for (int i = 0; i < 4; ++i) s_acc[t][i] += s_acc[t + s][i];
        barrier();
    }
    if (t != 0u) return;
    // Гармоники → освещённость: E(n) = π·Y00·c0 + 2π/3·Y1·c1·n; делим на π — яркость белой поверхности
    const float Y0 = 0.282095, Y1 = 0.488603;
    vec3 c0 = s_acc[0][0] * Y0;
    vec3 a = c0 * Y0;  // π·Y0·c0 / π
    vec3 bx = s_acc[0][1] * Y1 * Y1 * (2.0 / 3.0);
    vec3 by = s_acc[0][2] * Y1 * Y1 * (2.0 / 3.0);
    vec3 bz = s_acc[0][3] * Y1 * Y1 * (2.0 / 3.0);
    // Ночное свечение неба — равномерно сверху
    vec3 glow = vec3(0.55, 0.65, 1.0) * f.a_ground.w * f.a_sun.w;
    a += glow * 0.5;
    by += glow * 0.5;
    f.sky_out.v[0] = vec4(a, 0.0);
    f.sky_out.v[1] = vec4(bx, 0.0);
    f.sky_out.v[2] = vec4(by, 0.0);
    f.sky_out.v[3] = vec4(bz, 0.0);
    // Экспозиция: глаз привыкает к освещённости горизонтальной земли E (небо + главный свет, лк), не полностью —
    // ночь остаётся тёмной. Не по гистограмме кадра: одинаково при любом взгляде камеры. EV100 = log2(E / 2.5)
    // (экспонометр падающего света, C = 250); глаз сдвигает EV от «нормы» на долю adapt; множитель — как у камеры
    // с насыщением ISO 100: 2^поправка / (1.2 · 2^EV). Привыкание плавное: к темноте медленнее, к свету быстрее
    const vec3 Y = vec3(0.2126, 0.7152, 0.0722);
    float e_sky = max(dot((a + by) * A_PI, Y), 0.0);
    float e_key = max(dot(f.sun_color.rgb, Y), 0.0) * max(f.sun_dir.y, 0.0);
    float e = max(e_sky + e_key, 1e-6);
    float ev_scene = log2(e / 2.5);
    float ev_ref = f.a_post.z;
    float ev_goal = ev_ref + f.a_post.y * (ev_scene - ev_ref);
    float ev = ev_goal;
    float ev_prev = f.sky_out.v[SKY_OUT_EYE].z;
    // Прошлое значение годно, если не первый кадр и оно в разумных пределах (буфер в начале — мусор)
    if (f.eye_snap == 0u && ev_prev > -20.0 && ev_prev < 30.0) {
        float tau = ev_goal < ev_prev ? f.a_misc.y : f.a_misc.z;
        ev = ev_prev + (ev_goal - ev_prev) * (1.0 - exp(-max(f.dt, 0.0) / max(tau, 1e-3)));
    }
    float ex = exp2(f.a_post.x) / (1.2 * exp2(ev));
    f.sky_out.v[SKY_OUT_EYE] = vec4(ex, e, ev, e_sky);
    f.sky_out.v[SKY_OUT_EYE2] = vec4(e_key, ev_goal, 0.0, 0.0);
}
