#version 460
#extension GL_GOOGLE_include_directive : require
// Тени солнца (docs/shadow.md): отбор заслонок для новых страниц кадра. Поток на экземпляр: на каждом месте уровня
// (оба набора), где есть новые страницы, сфера сетки в плоскости карты задевает хоть одну новую → LOD по размеру текселя
// уровня (не по камере: страница одна и та же, когда бы ни нарисовалась) → кластеры, задевающие новые страницы,
// — в вызовы. Порядок вызовов от запуска к запуску разный, страница — нет: тексель берёт максимум высот.
// Биты новых страниц уровня читаются в локальный массив раз на уровень: и дешевле, и lavapipe под GPU-AV падает
// на чтении буфера во вложенных циклах (docs/shadow.md, «Проверки»)
#include "shadow.glsl"
layout(local_size_x = 64) in;

const uint MAX_MESHES = 4096u;    // RENDER_MAX_MESHES
const float LOD_TEXELS = 0.75;    // ошибка LOD не больше стольких текселей уровня

uint g_bits[32];  // новые страницы уровня: бит на место в окне
ivec2 g_base;     // начало окна уровня

// Квадрат w ± r (тексели окна уровня) задевает новую страницу
bool sm_touches_fresh(vec2 w, float r) {
    ivec2 lo, hi;
    if (!sm_rect(w, r, lo, hi)) return false;
    for (int y = lo.y; y <= hi.y; ++y)
        for (int x = lo.x; x <= hi.x; ++x) {
            ivec2 p = g_base + ivec2(x, y);
            uint local = uint(p.y & (SM_WIN - 1)) * uint(SM_WIN) + uint(p.x & (SM_WIN - 1));
            if ((g_bits[local >> 5] & (1u << (local & 31u))) != 0u) return true;
        }
    return false;
}

void main() {
    FrameData f = pc.frame;
    uint i = gl_GlobalInvocationID.x;
    if (i >= f.instance_count) return;
    Instance it = f.vis_instances.v[i];
    if (it.mesh == 0u || it.mesh >= MAX_MESHES) return;
    MeshInfo m = f.meshes.v[it.mesh];
    if (m.lod_count == 0u || (m.flags & MESH_DYNAMIC) != 0u) return;
    vec4 q = inst_quat(it);
    vec3 origin = rel_to_camera(ivec2(it.cx, it.cz), vec3(it.x, it.y, it.z));
    vec3 c = origin + quat_rotate(q, m.sphere.xyz * it.scale);
    float r = m.sphere.w * it.scale;
    uint want = 0u;
    for (int k = 0; k < SM_SLOTS; ++k) {
        if (f.sm_req.fresh[k] == 0u) continue;
        float t = sm_texel(k);
        if (r < SM_MIN_TEXELS * t) continue;
        for (int w = 0; w < 32; ++w) g_bits[w] = f.sm_req.bits[k * 32 + w];
        g_base = f.sm_base[k];
        if (!sm_touches_fresh(sm_window(c, k), r / t + 1.0)) continue;
        uint lod = 0u;
        while (lod + 1u < m.lod_count && uintBitsToFloat(m.lods[lod + 1u].z) * it.scale <= LOD_TEXELS * t) lod++;
        uvec4 L = m.lods[lod];
        for (uint j = 0u; j < L.y; ++j) {
            uint ci = L.x + j;
            Cluster cl = f.clusters.v[ci];
            if (!sm_touches_fresh(sm_window(origin + quat_rotate(q, cl.sphere.xyz * it.scale), k), cl.sphere.w * it.scale / t + 1.0)) continue;
            want++;
            uint slot = atomicAdd(f.sm_draws.count, 1u);
            if (slot >= f.sm_draw_cap) continue;
            f.sm_list.v[slot] = uvec2(i, ci | uint(k) << 27);
            SmDrawCmd d;
            d.index_count = cl.tri_count * 3u;
            d.instance_count = 1u;
            d.first_index = m.first_index + cl.first_index;
            d.vertex_offset = int(m.first_vertex);
            d.first_instance = slot;
            f.sm_draws.v[slot] = d;
        }
    }
    if (want != 0u) atomicAdd(f.stats.v[STAT_SM_DRAWS], want);
}
