#version 460
#extension GL_GOOGLE_include_directive : require
// Отражённый свет в кеше земли (docs/gcache.md, «Отражённый свет в кеше»): группа — физическая страница, поток —
// тексель. Рассеянный отражённый свет земли (зонды и ячейки, ближнее затенение по полю, видимость неба вне окон
// зондов) от камеры почти не зависит и меняется за доли секунды, поэтому считается не на пиксель каждый кадр, а в
// тексель кеша: страница без света (только запечена) и с устаревшим (не читалась дольше круга) — сразу, остальные
// прочитанные кадром — по кругу, раз в gc_lperiod кадров (место в круге — место страницы в мире), все — при GC_LIGHT_ALL
// (снимок, смена настроек света).
// Освещение (light_cells.comp → light_indirect) смешивает четыре текселя теми же долями, что поверхность.
// Те же функции, что и на пиксель: gi_sample, lc_gather, lc_ao, sdf_sky; точка — центр текселя на его высоте
ivec2 g_origin;
#define ORIGIN_CHUNK g_origin
#include "gcache.glsl"
#include "froxel.glsl"
#include "light.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

shared uint s_n, s_taps;  // посчитано текселей, выборок поля (идут в STAT_SDF_TAPS: это работа света)

void main() {
    FrameData f = pc.frame;
    g_origin = f.cam_chunk;
    uint phys = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (phys >= f.gc_pages_n) return;
    GcPage pg = f.gc_pages.v[phys];
    // Страница не прочитана кадром — не нужна; прочитана — свежая, в свой черёд круга или все разом
    if (pg.used != f.gc_frame) return;
    // Место в круге — от места страницы в мире, не от номера в пуле: номер зависит от порядка атомиков, а кадр
    // должен быть один от запуска к запуску (сверка CI). Соседние страницы — в разные кадры
    uvec2 key = uvec2(pg.key0, pg.key1);
    int k = gc_key_level(key);
    ivec2 kp = gc_key_page(key);
    uint per = max(f.gc_lperiod, 1u);
    uint turn = uint(kp.x) + 3u * uint(kp.y) + uint(k);
    bool due = pg.lit == 0u || pg.lit < f.gc_lit_min || f.gc_frame - pg.lit > per || (f.gc_lmode & GC_LIGHT_ALL) != 0u ||
               (turn + f.gc_frame) % per == 0u;
    if (!due) return;
    uint t = gl_LocalInvocationIndex;
    if (t == 0u) s_n = s_taps = 0u;
    barrier();
    ivec2 tx = kp * GC_PAGE + ivec2(gl_LocalInvocationID.xy);
    uint at = phys * 64u + t;
    uvec4 v = f.gc_texels.v[at];
    // Нормаль — среднее двух вариантов следа (у дальней земли они почти совпадают)
    vec3 n = normalize(gc_unpack(v.xy).normal + gc_unpack(v.zw).normal + vec3(0.0, 1e-6, 0.0));
    float h = uintBitsToFloat(f.gc_light.v[at].x);
    float c = gc_cell(k);
    ivec2 lt = tx - (f.cam_chunk - ivec2(f.t_chunk0)) * (f.gc_tpc0 >> k);
    vec2 xz = (vec2(lt) + 0.5) * c - f.cam_off.xz;
    vec3 pos = vec3(xz.x, h - f.cam_off.y, xz.y);

    g_ground = 1.0;  // поверхность самой земли: под грунтом не бывает (gi_buried)
    g_moving = 0.0;
    GiSample g = gi_sample(pos, n, n, true);
    float vis = 1.0, ao = 1.0;
    vec3 irr = vec3(0.0);
    if (g.cov < 1.0) vis = sdf_sky(pos, n).x;
    if (g.cov > 0.0) {
        float ao_c = 1.0;
        vec4 lc = lc_use() ? lc_gather(pos, n, true, ao_c) : vec4(0.0);
        irr = mix(g.irr, lc.rgb, lc.a);
        ao = lc_ao(pos, n, lc.a, ao_c);
    }
    f.gc_light.v[at] = uvec4(floatBitsToUint(h), packHalf2x16(irr.rg), packHalf2x16(vec2(irr.b, 1.0)),
                             packUnorm4x8(vec4(g.cov, vis, ao, g.refl.a)));
    atomicAdd(s_n, 1u);
    if (g_sdf_taps != 0u) atomicAdd(s_taps, g_sdf_taps);
    barrier();
    if (t == 0u) {
        f.gc_pages.v[phys].lit = f.gc_frame;
        atomicAdd(f.stats.v[STAT_GC_LIT], s_n);
        if (s_taps != 0u) atomicAdd(f.stats.v[STAT_SDF_TAPS], s_taps);
    }
}
