// Стиль кадра (docs/render.md, проход 8; docs/light.md, «Экспозиция», «Тонмаппинг»): HDR кадра уже умножен на
// экспозицию (light_cells.comp — иначе диск солнца и блики не влезут в f16). Здесь ночная синева и тонмаппинг:
// AgX или ACES (Hill), переключатель в F3. Средний серый у обоих один: ACES подтянут к AgX множителем
#ifndef POST_GLSL
#define POST_GLSL
#include "common.glsl"

// AgX (Troy Sobotka; приближение полиномом — Benjamin Wrensch 2023): в лог-пространстве с запасом по краям,
// насыщенное светлое уходит в белое, а не в кислотный цвет. Выход — линейный (картинка swapchain *_SRGB)
vec3 tonemap_agx(vec3 c) {
    const mat3 to_agx = mat3(0.842479062253094, 0.0423282422610123, 0.0423756549057051,
                             0.0784335999999992, 0.878468636469772, 0.0784336,
                             0.0792237451477643, 0.0791661274605434, 0.879142973793104);
    const mat3 from_agx = mat3(1.19687900512017, -0.0528968517574562, -0.0529716355144438,
                               -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
                               -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
    const float lo = -12.47393, hi = 4.026069;
    vec3 x = clamp(log2(max(to_agx * c, vec3(1e-10))), lo, hi);
    x = (x - lo) / (hi - lo);
    vec3 x2 = x * x, x4 = x2 * x2;
    x = 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;
    return pow(max(from_agx * x, vec3(0.0)), vec3(2.2));
}

// ACES (RRT + ODT sRGB) в приближении Stephen Hill: с матрицами в пространство ACES и обратно, светлое
// насыщенное уходит в тон, а не в белое. ×1.68 — средний серый 0.18 как у AgX
vec3 tonemap_aces(vec3 c) {
    const mat3 to_aces = mat3(0.59719, 0.07600, 0.02840, 0.35458, 0.90834, 0.13383, 0.04823, 0.01566, 0.83777);
    const mat3 from_aces = mat3(1.60475, -0.10208, -0.00327, -0.53108, 1.10813, -0.07276, -0.07367, -0.00605, 1.07602);
    vec3 v = to_aces * (c * 1.68);
    v = (v * (v + 0.0245786) - 0.000090537) / (v * (0.983729 * v + 0.4329510) + 0.238081);
    return clamp(from_aces * v, 0.0, 1.0);
}

vec3 post_color(vec3 c) {
    FrameData f = pc.frame;
    c = max(c, vec3(0.0));
    // Ночью глаз видит палочками: цвет уходит в холодный серо-синий. По освещённости земли, лк: полная
    // синева — ниже ~10 лк (глубокие сумерки, луна), без неё — выше ~600 лк (солнце у горизонта)
    float e = f.sky_out.v[SKY_OUT_EYE].y;
    float night = f.a_post.w * (1.0 - smoothstep(10.0, 600.0, e));
    float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
    c = mix(c, l * vec3(0.72, 0.88, 1.25), night);
    return f.tonemap == TONEMAP_ACES ? tonemap_aces(c) : tonemap_agx(c);
}
#endif
