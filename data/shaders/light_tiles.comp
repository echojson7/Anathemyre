#version 460
#extension GL_GOOGLE_include_directive : require
// Разбор плиток кадра мира по видам (docs/tiles.md): группа — плитка 8×8 visibility buffer. Что в плитке есть
// (небо, земля, сетки), решает вид; плитка ложится в список своего вида, а число плиток вида — в его косвенный
// dispatch. Освещение (light_cells.comp) потом считает каждый вид своим конвейером. Порядок плиток в списке
// зависит от потоков GPU, картинка — нет: плитка считается одинаково, где бы ни лежала в списке.
// Заодно — ячейки земли (docs/gcache.md): пиксель земли разбирается, его тексель кеша пишется в gc_cells,
// страница текселя отмечается прочитанной или заявляется на запекание. Пиксель земли мимо кеша (крутой склон)
// уводит плитку в «землю на пиксель», а если в ней есть и сетки — в «смесь».
// И заявки страниц теней солнца (docs/shadow.md): точка каждого пикселя земли и сеток заявляет страницы,
// которые прочтёт свет его ячейки. И заявки ячеек света (docs/lcache.md): ячейки под точкой пикселя; соседи по
// плитке с той же главной ячейкой заявок не повторяют. И для воздуха (docs/air.md): расстояния половины кадра (2×2
// пикселя шахматкой — дальний и ближний: у края предмета соседи несут оба) и дальний край плитки воздуха
#define RESOLVE_GROUND true
#define RESOLVE_MESH true
#include "resolve.glsl"
#include "gcache.glsl"
#include "shadow_req.glsl"
#include "air.glsl"
#define LC_CLAIM
#include "lcache.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, r32ui) uniform readonly uimage2D u_vis;

shared uint s_has;  // 1 — небо, 2 — земля, 4 — сетки, 8 — земля мимо кеша
shared uint s_lc[64];  // главная ячейка света пикселя (0 — без ячеек)
shared float s_air_d[64];  // расстояние до точки пикселя вдоль луча, м (небо — AIR_SKY; −1 — пиксель за кадром)
shared uint s_air_max;     // дальний край плитки по лучам до AIR_FAR (биты float: порядок слов — порядок чисел)
const float AIR_SKY = 1.0e6;

// Сетка пикселя движется сама (люди): ячейки мира ей не подходят, свет у неё — от зондов
bool lc_dynamic(uint id) {
    FrameData f = pc.frame;
    uvec2 vc = f.vis.v[(id >> 7) - 1u];
    return (f.meshes.v[f.vis_instances.v[vc.x].mesh].flags & MESH_DYNAMIC) != 0u;
}

// Страница текселя нужна кадру: прочитана — отметка кадра (по ней старые страницы отдаются первыми), нет —
// заявка: запись окна → GC_REQ | кадр, ключ — в список заявок. Заявку ставит один пиксель (сравнение с обменом)
void gc_touch(int k, ivec2 t) {
    FrameData f = pc.frame;
    ivec2 page = t >> 3;
    uvec2 key = gc_page_key(k, page);
    uint slot = gc_slot(k, page);
    uint req = GC_REQ | (f.gc_frame & 0x7FFFFFFFu);
    uint e = f.gc_table.v[slot];
    if (e == req) return;
    if (e != 0u && (e & GC_REQ) == 0u) {
        uint phys = e - 1u;
        GcPage pg = f.gc_pages.v[phys];
        if (uvec2(pg.key0, pg.key1) == key) {
            if (pg.used != f.gc_frame && atomicExchange(f.gc_pages.v[phys].used, f.gc_frame) != f.gc_frame)
                atomicAdd(f.stats.v[STAT_GC_USED], 1u);
            return;
        }
    }
    // Пусто, заявка прошлого кадра или окно занято другой страницей того же места
    if (atomicCompSwap(f.gc_table.v[slot], e, req) != e) return;  // заявил другой пиксель
    uint i = atomicAdd(f.gc_req.req_n, 1u);
    if (i < f.gc_req_cap) {
        f.gc_req.v[2u * i] = key.x;
        f.gc_req.v[2u * i + 1u] = key.y;
    } else {
        f.gc_table.v[slot] = 0u;  // список заявок полон: страница остаётся без места (освещение — на пиксель)
    }
}

// След пикселя на плоскости его треугольника (точка rel, нормаль ng): углы пикселя без дрожания, то есть всё, куда
// может попасть точка пикселя при любой фазе дрожания TAA (docs/aa.md). ok — все четыре луча упёрлись в плоскость
// (иначе пиксель задевает её горизонт)
struct PxFoot {
    vec3 p[4];
    bool ok;
};
PxFoot px_foot(ivec2 px, vec3 rel, vec3 ng) {
    FrameData f = pc.frame;
    PxFoot r;
    r.ok = true;
    float h = dot(rel, ng);
    [[unroll]] for (int j = 0; j < 4; ++j) {
        vec2 ndc = (vec2(px) + vec2(j & 1, j >> 1)) * f.ndc_per_pixel - 1.0;
        vec3 dir = f.forward.xyz + f.right.xyz * (ndc.x / f.proj_x) - f.up.xyz * (ndc.y / f.proj_y);
        float dn = dot(dir, ng);
        float t = abs(dn) > 1e-6 ? h / dn : -1.0;
        r.ok = r.ok && t > 0.0;
        r.p[j] = t > 0.0 ? dir * t : rel;
    }
    return r;
}

// Вытянутость следа, которую кеш земли оставляет дрожанию TAA: уровень текселя — не мельче трети длинной стороны
// следа. Луч вдоль земли не берёт тексель мельче пикселя поперёк, а след и его страницы остаются в окне 4 × 4
// текселя; деталь вдоль луча мельче трёх пикселей кадр копит дрожанием (как анизотропная фильтрация ×3)
const float GC_ANISO = 0.3;

// След пикселя для уровня кеша земли (м): поперечный по средней глубине углов и треть длинной стороны
float gc_foot(PxFoot pf) {
    FrameData f = pc.frame;
    if (!pf.ok) return 1e9;
    vec3 w = f.forward.xyz;
    float depth = 0.25 * (dot(pf.p[0], w) + dot(pf.p[1], w) + dot(pf.p[2], w) + dot(pf.p[3], w));
    float side = max(max(distance(pf.p[0], pf.p[1]), distance(pf.p[2], pf.p[3])),
                     max(distance(pf.p[0], pf.p[2]), distance(pf.p[1], pf.p[3])));
    return max(depth * f.pixel_angle * f.cell_pixels, side * GC_ANISO);
}

// Страницы под текселями lo … hi уровня k (окно не шире 10 текселей — не больше 3 × 3 страниц). Без цикла
// (lavapipe под GPU-AV, docs/shadow.md)
void gc_touch_span(int k, ivec2 lo, ivec2 hi) {
    ivec2 p0 = lo >> 3, p2 = hi >> 3;
    bool x1 = p2.x > p0.x, x2 = p2.x > p0.x + 1, z1 = p2.y > p0.y, z2 = p2.y > p0.y + 1;
    ivec2 t0 = lo, t1 = (p0 + 1) * 8, t2 = hi;
    gc_touch(k, t0);
    if (x1) gc_touch(k, ivec2(t1.x, t0.y));
    if (x2) gc_touch(k, ivec2(t2.x, t0.y));
    if (z1) {
        gc_touch(k, ivec2(t0.x, t1.y));
        if (x1) gc_touch(k, t1);
        if (x2) gc_touch(k, ivec2(t2.x, t1.y));
    }
    if (z2) {
        gc_touch(k, ivec2(t0.x, t2.y));
        if (x1) gc_touch(k, ivec2(t1.x, t2.y));
        if (x2) gc_touch(k, t2);
    }
}

// Тексели уровня k, которые смешает пиксель при любой фазе дрожания: четыре соседних под каждой точкой следа.
// Окно урезается вокруг текселя b самой точки пикселя (след у горизонта плоскости)
void gc_touch_level(int k, ivec2 b, PxFoot pf) {
    FrameData f = pc.frame;
    vec2 mn = min(min(pf.p[0].xz, pf.p[1].xz), min(pf.p[2].xz, pf.p[3].xz));
    vec2 mx = max(max(pf.p[0].xz, pf.p[1].xz), max(pf.p[2].xz, pf.p[3].xz));
    ivec2 sh = (f.cam_chunk - ivec2(f.t_chunk0)) * (f.gc_tpc0 >> k);
    float c = gc_cell(k);
    ivec2 lo = ivec2(floor((f.cam_off.xz + mn) / c - 0.5)) + sh;
    ivec2 hi = ivec2(floor((f.cam_off.xz + mx) / c - 0.5)) + 1 + sh;
    gc_touch_span(k, clamp(lo, b - 4, b), clamp(hi, b + 1, b + 5));
}

// На пиксель: страницы под следом пикселя — кадр покоя не запекает новых страниц, на какой бы фазе дрожания ни
// стоял. След почти у границы уровней (плоскость под соседней фазой может быть другого треугольника) — и
// соседний уровень
void gc_touch_px(vec3 rel, GcCell cell, PxFoot pf, float foot) {
    int k = gc_cell_level(cell);
    gc_touch_level(k, gc_cell_texel(cell), pf);
    float lf = log2(max(foot / pc.frame.cell_min, 1.0));
    int ko = lf > 0.0 && float(k) - lf < 0.05 ? k + 1 : (lf - float(k - 1) < 0.05 && k > 0) ? k - 1 : k;
    if (ko != k && ko < GC_LEVELS) {
        vec2 fr;
        gc_touch_level(ko, gc_bilinear(rel, ko, fr), pf);
    }
}

// Разброс точки пикселя по фазам дрожания (м): даль от точки до углов следа, не больше 1 м. Для заявок теней
float px_spread(vec3 rel, PxFoot pf) {
    float r = max(max(distance(pf.p[0], rel), distance(pf.p[1], rel)), max(distance(pf.p[2], rel), distance(pf.p[3], rel)));
    return pf.ok ? min(r, 1.0) : 1.0;
}

// Страницы места k под квадратом разброса центра ячейки (m — его полуширина, м) с запасом на смещение по
// нормали, четыре текселя выборки и круг поиска PCSS: квадрат много меньше страницы и задевает не больше 2×2
void sm_request_level(vec3 rel, float m, int set, int lv, bool bg) {
    FrameData f = pc.frame;
    if (lv >= SM_LEVELS) return;
    int k = set * SM_LEVELS + lv;
    float t = sm_texel(k);
    float rs = sm_search(t);
    vec2 par = rs > 0.0 ? sm_par(set) / t : vec2(0.0);  // сдвиг выборки к настоящему светилу (sm_vis_set)
    float r = (m + 1.8 * t) / t + 1.5 + rs + SM_PCSS_FAR * (abs(par.x) + abs(par.y));
    sm_touch_square(k, sm_window(rel, k), r, bg);
}

// Страницы набора set, которые прочтёт свет этого пикселя. Правило ячеек: свет — в центре ячейки, он дальше от
// точки пикселя не больше чем на ячейку; на пиксель — точка ходит по фазам дрожания TAA на spread. Заявляются
// уровни обоих краёв разброса и страницы под его квадратом с запасом на смещение по нормали, выборку и поиск
// (sm_visibility)
void sm_request_set(vec3 rel, float spread, int set, bool bg) {
    FrameData f = pc.frame;
    float depth = dot(rel, f.forward.xyz);
    float m = (f.pixel != 0u ? cell_size(depth) * 0.9 : spread) + 0.004;
    if (length(rel) - m > f.sm_far) return;
    vec2 ru = sm_ru(rel, set);
    float far = max(abs(ru.x), abs(ru.y));
    int k0 = sm_level(depth - m, max(far - m, 0.0));
    int k1 = min(sm_level(depth + m, far + m), k0 + 2);
    // Без циклов: lavapipe под GPU-AV падает на доступе к буферу в цикле шейдера с barrier() (docs/shadow.md,
    // «Проверки»), а уровней не больше трёх и страниц на уровень не больше 2×2
    sm_request_level(rel, m, set, k0, bg);
    if (k0 + 1 <= k1) sm_request_level(rel, m, set, k0 + 1, bg);
    if (k0 + 2 <= k1) sm_request_level(rel, m, set, k0 + 2, bg);
}

// Заявки обоих наборов: показанные — сразу, набор в фоне — своим списком
void sm_request(vec3 rel, float spread) {
    FrameData f = pc.frame;
    if (f.sm_on == 0u) return;
    if ((f.sm_read & 1u) != 0u || f.sm_bg == 1u) sm_request_set(rel, spread, 0, f.sm_bg == 1u);
    if ((f.sm_read & 2u) != 0u || f.sm_bg == 2u) sm_request_set(rel, spread, 1, f.sm_bg == 2u);
}
void main() {
    FrameData f = pc.frame;
    if (gl_LocalInvocationIndex == 0u) s_has = s_air_max = 0u;
    barrier();
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    uint t = gl_LocalInvocationIndex;
    uint lc0 = 0u;
    vec3 lc_rel = vec3(0.0), lc_n = vec3(0.0);
    float air_d = -1.0;
    if (px.x < int(f.viewport.x) && px.y < int(f.viewport.y)) {
        uint id = imageLoad(u_vis, px).r;
        uint has = id == 0u ? 1u : (id & VIS_GROUND) != 0u ? 2u : 4u;
        air_d = AIR_SKY;
        if (has != 1u) {
            Hit h = resolve(px, id);
            air_d = length(h.rel);
            if (has == 2u || !lc_dynamic(id)) {
                lc_rel = h.rel;
                lc_n = normalize(h.n);
                lc0 = lc_primary(lc_rel, lc_n, has == 2u);
            }
            PxFoot pf;
            float foot = 0.0;
            if (f.pixel == 0u) {
                pf = px_foot(px, h.rel, h.ng);
                foot = gc_foot(pf);
            }
            if (has == 2u) {
                GcCell c = gc_cell_of(h.rel, h.ng, foot);
                if (f.gc_on != 0u) f.gc_cells.v[px.y * int(f.viewport.x) + px.x] = c;
                if (c.kt == GC_NONE) has |= 8u;
                else if (f.pixel != 0u) gc_touch(gc_cell_level(c), gc_cell_texel(c));
                else gc_touch_px(h.rel, c, pf, foot);
            }
            sm_request(h.rel, f.pixel != 0u ? 0.0 : px_spread(h.rel, pf));
        }
        atomicOr(s_has, has);
        if (f.air_on != 0u) atomicMax(s_air_max, floatBitsToUint(min(air_d, AIR_FAR)));
    }
    s_lc[t] = lc0;
    s_air_d[t] = air_d;
    barrier();
    // Воздух: пиксель половины кадра — у левого верхнего из своих 2×2; через один — дальний и ближний из четырёх
    uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;
    if (f.air_on != 0u && air_d >= 0.0 && (lx & 1u) == 0u && (ly & 1u) == 0u) {
        uvec2 hp = uvec2(px) >> 1u;
        float d1 = s_air_d[t + 1u], d2 = s_air_d[t + 8u], d3 = s_air_d[t + 9u];
        float dm = ((hp.x + hp.y) & 1u) == 0u ? max(max(air_d, d1), max(d2, d3))
                 : min(min(air_d, d1 < 0.0 ? AIR_SKY : d1), min(d2 < 0.0 ? AIR_SKY : d2, d3 < 0.0 ? AIR_SKY : d3));
        f.air_depth.v[hp.y * f.air_w2 + hp.x] = dm;
    }
    // Ячейки света: заявляет пиксель, у которого главная ячейка не та же, что у соседа слева и сверху по плитке
    if (lc0 != 0u && (lx == 0u || s_lc[t - 1u] != lc0) && (ly == 0u || s_lc[t - 8u] != lc0))
        lc_request(lc_rel, lc_n, (lc0 & LC_GROUND) != 0u);
    if (t != 0u) return;
    // Дальний край плитки воздуха (AIR_TILE = 16 — две плитки разбора по каждой оси)
    if (f.air_on != 0u && s_air_max != 0u)
        atomicMax(f.air_tmax.v[(gl_WorkGroupID.y >> 1u) * f.air_nx + (gl_WorkGroupID.x >> 1u)], s_air_max);
    uint has = s_has;
    uint kind = (has & 6u) == 6u ? TILE_MIX : (has & 8u) != 0u ? TILE_GROUND_PX : (has & 2u) != 0u ? TILE_GROUND
              : (has & 4u) != 0u ? TILE_MESH : TILE_SKY;
    uint slot = atomicAdd(f.tiles.cmd[kind].x, 1u);
    f.tiles.list[kind * f.tile_cap + slot] = gl_WorkGroupID.x | gl_WorkGroupID.y << 16;
    atomicAdd(f.stats.v[STAT_TILES + kind], 1u);
}
