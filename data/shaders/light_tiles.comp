#version 460
#extension GL_GOOGLE_include_directive : require
// Разбор плиток кадра мира по видам (docs/tiles.md): группа — плитка 8×8 visibility buffer. Что в плитке есть
// (небо, земля, сетки), решает вид; плитка ложится в список своего вида, а число плиток вида — в его косвенный
// dispatch. Освещение (light_cells.comp) потом считает каждый вид своим конвейером. Порядок плиток в списке
// зависит от потоков GPU, картинка — нет: плитка считается одинаково, где бы ни лежала в списке.
// Заодно — ячейки земли (docs/gcache.md): пиксель земли разбирается, его тексель кеша пишется в gc_cells,
// страница текселя отмечается прочитанной или заявляется на запекание. Пиксель земли мимо кеша (крутой склон)
// уводит плитку в «землю на пиксель», а если в ней есть и сетки — в «смесь».
// И заявки страниц теней солнца (docs/shadow.md): точка каждого пикселя земли и сеток заявляет страницы,
// которые прочтёт свет его ячейки
#define RESOLVE_GROUND true
#define RESOLVE_MESH true
#include "resolve.glsl"
#include "gcache.glsl"
#include "shadow.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, r32ui) uniform readonly uimage2D u_vis;

shared uint s_has;  // 1 — небо, 2 — земля, 4 — сетки, 8 — земля мимо кеша

// Страница текселя нужна кадру: прочитана — отметка кадра (по ней старые страницы отдаются первыми), нет —
// заявка: запись окна → GC_REQ | кадр, ключ — в список заявок. Заявку ставит один пиксель (сравнение с обменом)
void gc_touch(int k, ivec2 t) {
    FrameData f = pc.frame;
    ivec2 page = t >> 3;
    uvec2 key = gc_page_key(k, page);
    uint slot = gc_slot(k, page);
    uint req = GC_REQ | (f.gc_frame & 0x7FFFFFFFu);
    uint e = f.gc_table.v[slot];
    if (e == req) return;
    if (e != 0u && (e & GC_REQ) == 0u) {
        uint phys = e - 1u;
        GcPage pg = f.gc_pages.v[phys];
        if (uvec2(pg.key0, pg.key1) == key) {
            if (pg.used != f.gc_frame && atomicExchange(f.gc_pages.v[phys].used, f.gc_frame) != f.gc_frame)
                atomicAdd(f.stats.v[STAT_GC_USED], 1u);
            return;
        }
    }
    // Пусто, заявка прошлого кадра или окно занято другой страницей того же места
    if (atomicCompSwap(f.gc_table.v[slot], e, req) != e) return;  // заявил другой пиксель
    uint i = atomicAdd(f.gc_req.req_n, 1u);
    if (i < f.gc_req_cap) {
        f.gc_req.v[2u * i] = key.x;
        f.gc_req.v[2u * i + 1u] = key.y;
    } else {
        f.gc_table.v[slot] = 0u;  // список заявок полон: страница остаётся без места (освещение — на пиксель)
    }
}

// Страница теней нужна кадру: прочитана — отметка кадра, нет — заявка (как gc_touch). bg — набор нового шага
// светила, что строится в фоне: его заявки — в свой список, место им дают не больше sm_build_cap за кадр
void sm_touch(int k, ivec2 page, bool bg) {
    FrameData f = pc.frame;
    uvec2 key = sm_page_key(k, page);
    uint slot = sm_slot(k, page);
    uint req = SM_REQ | (f.sm_frame & 0x7FFFFFFFu);
    uint e = f.sm_table.v[slot];
    if (e == req) return;
    if (e != 0u && (e & SM_REQ) == 0u) {
        uint phys = e - 1u;
        SmPage pg = f.sm_pages.v[phys];
        if (uvec2(pg.key0, pg.key1) == key) {
            if (pg.used != f.sm_frame && atomicExchange(f.sm_pages.v[phys].used, f.sm_frame) != f.sm_frame)
                atomicAdd(f.stats.v[STAT_SM_USED], 1u);
            return;
        }
    }
    if (atomicCompSwap(f.sm_table.v[slot], e, req) != e) return;  // заявил другой пиксель
    uint i = bg ? atomicAdd(f.sm_req.bg_n, 1u) : atomicAdd(f.sm_req.req_n, 1u);
    if (i < f.sm_req_cap) {
        uint at = bg ? 2u * (f.sm_req_cap + i) : 2u * i;
        f.sm_req.v[at] = key.x;
        f.sm_req.v[at + 1u] = key.y;
    } else {
        f.sm_table.v[slot] = 0u;  // список заявок полон: страница без места (свет там — без тени)
    }
}

// Страницы места k под квадратом разброса центра ячейки (m — его полуширина, м) с запасом на смещение по
// нормали, четыре текселя выборки и круг поиска PCSS: квадрат много меньше страницы и задевает не больше 2×2
void sm_request_level(vec3 rel, float m, int set, int lv, bool bg) {
    FrameData f = pc.frame;
    if (lv >= SM_LEVELS) return;
    int k = set * SM_LEVELS + lv;
    float t = sm_texel(k);
    float r = (m + 1.8 * t) / t + 1.5 + sm_search(t);
    ivec2 lo, hi;
    if (!sm_rect(sm_window(rel, k), r, lo, hi)) return;
    ivec2 b = f.sm_base[k];
    sm_touch(k, b + lo, bg);
    if (hi.x > lo.x) sm_touch(k, b + ivec2(lo.x + 1, lo.y), bg);
    if (hi.y > lo.y) sm_touch(k, b + ivec2(lo.x, lo.y + 1), bg);
    if (hi.x > lo.x && hi.y > lo.y) sm_touch(k, b + lo + 1, bg);
}

// Страницы набора set, которые прочтёт свет ячейки этого пикселя. Свет считается в центре ячейки, а он дальше от
// точки пикселя не больше чем на ячейку: заявляются уровни обоих краёв этого разброса и страницы под квадратом
// разброса с запасом на смещение по нормали, выборку и поиск (sm_visibility)
void sm_request_set(vec3 rel, int set, bool bg) {
    FrameData f = pc.frame;
    float depth = dot(rel, f.forward.xyz);
    float m = (f.pixel != 0u ? cell_size(depth) : f.cell_min) * 0.9 + 0.004;
    if (length(rel) - m > f.sm_far) return;
    vec2 ru = sm_ru(rel, set);
    float far = max(abs(ru.x), abs(ru.y));
    int k0 = sm_level(depth - m, max(far - m, 0.0));
    int k1 = min(sm_level(depth + m, far + m), k0 + 2);
    // Без циклов: lavapipe под GPU-AV падает на доступе к буферу в цикле шейдера с barrier() (docs/shadow.md,
    // «Проверки»), а уровней не больше трёх и страниц на уровень не больше 2×2
    sm_request_level(rel, m, set, k0, bg);
    if (k0 + 1 <= k1) sm_request_level(rel, m, set, k0 + 1, bg);
    if (k0 + 2 <= k1) sm_request_level(rel, m, set, k0 + 2, bg);
}

// Заявки обоих наборов: показанные — сразу, набор в фоне — своим списком
void sm_request(vec3 rel) {
    FrameData f = pc.frame;
    if (f.sm_on == 0u) return;
    if ((f.sm_read & 1u) != 0u || f.sm_bg == 1u) sm_request_set(rel, 0, f.sm_bg == 1u);
    if ((f.sm_read & 2u) != 0u || f.sm_bg == 2u) sm_request_set(rel, 1, f.sm_bg == 2u);
}

void main() {
    FrameData f = pc.frame;
    if (gl_LocalInvocationIndex == 0u) s_has = 0u;
    barrier();
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x < int(f.viewport.x) && px.y < int(f.viewport.y)) {
        uint id = imageLoad(u_vis, px).r;
        uint has = id == 0u ? 1u : (id & VIS_GROUND) != 0u ? 2u : 4u;
        if (has != 1u) {
            Hit h = resolve(px, id);
            if (has == 2u) {
                GcCell c = gc_cell_of(h.rel, h.ng);
                if (f.gc_on != 0u) f.gc_cells.v[px.y * int(f.viewport.x) + px.x] = c;
                if (c.kt == GC_NONE) has |= 8u;
                else gc_touch(gc_cell_level(c), gc_cell_texel(c));
            }
            sm_request(h.rel);
        }
        atomicOr(s_has, has);
    }
    barrier();
    if (gl_LocalInvocationIndex != 0u) return;
    uint has = s_has;
    uint kind = (has & 6u) == 6u ? TILE_MIX : (has & 8u) != 0u ? TILE_GROUND_PX : (has & 2u) != 0u ? TILE_GROUND
              : (has & 4u) != 0u ? TILE_MESH : TILE_SKY;
    uint slot = atomicAdd(f.tiles.cmd[kind].x, 1u);
    f.tiles.list[kind * f.tile_cap + slot] = gl_WorkGroupID.x | gl_WorkGroupID.y << 16;
    atomicAdd(f.stats.v[STAT_TILES + kind], 1u);
}
